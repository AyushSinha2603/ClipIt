{
  "manifest_version": 3,
  "name": "ClipIt Note Taker",
  "version": "1.0",
  "description": "Capture highlights and screenshots chronologically into a PDF.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}